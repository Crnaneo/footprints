# Obtain an official Flightradar24 API token separately.
# Keep the real value in .env on this machine; never commit or export it.
FR24_API_TOKEN=
# Current subscription history window; older flights go directly to ADS-B.
FR24_HISTORY_DAYS=30
# Optional OpenSky OAuth2 client credentials (free account) for the
# flight-number reconstruction chain: flight number + date → icao24 → track.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Optional path for SQLite and uploaded source files:
# FOOTPRINT_DATA_DIR=/absolute/path/to/footprint-data
